<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="#FFFFFF">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Perfil"
        android:textSize="30sp"
        android:textStyle="bold"
        android:layout_marginBottom="32dp"/>

    <LinearLayout
        android:id="@+id/layout_invitado"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Inicia sesión para empezar a planear tu próximo viaje."
            android:textSize="16sp"
            android:textColor="#717171"
            android:layout_marginBottom="24dp"/>

        <Button
            android:id="@+id/btnIrALogin"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:text="inicia sesion o registrate"
            android:backgroundTint="#FF5A5F"
            android:textAllCaps="false"
            android:textStyle="bold"/>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/layout_usuario"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:id="@+id/tvNombreUsuario"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="¡Hola, Jesus!"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginBottom="16dp"/>

        <Button
            android:id="@+id/btnCerrarSesion"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="Cerrar sesión"
            android:backgroundTint="#F5F5F5"
            android:textColor="#000000"
            android:textAllCaps="false"
            android:layout_marginTop="20dp"/>
    </LinearLayout>

</LinearLayout>
