<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Publica una nueva propiedad"
            android:textColor="#111111"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Completa la información básica para empezar tu flujo anfitrión."
            android:textColor="#717171"
            android:textSize="15sp" />

        <EditText
            android:id="@+id/etHostTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@android:drawable/edit_text"
            android:hint="Título"
            android:inputType="textCapSentences"
            android:minHeight="48dp"
            android:padding="12dp" />

        <EditText
            android:id="@+id/etHostDescription"
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:layout_marginTop="12dp"
            android:gravity="top|start"
            android:hint="Descripción"
            android:inputType="textMultiLine|textCapSentences"
            android:padding="12dp" />

        <EditText
            android:id="@+id/etHostCity"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="Ciudad"
            android:inputType="textCapWords"
            android:minHeight="48dp"
            android:padding="12dp" />

        <EditText
            android:id="@+id/etHostAddress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="Dirección completa"
            android:inputType="textPostalAddress"
            android:minHeight="48dp"
            android:padding="12dp" />

        <Spinner
            android:id="@+id/spinnerHostType"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp" />

        <EditText
            android:id="@+id/etHostPrice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="Precio por noche"
            android:inputType="numberDecimal"
            android:minHeight="48dp"
            android:padding="12dp" />

        <EditText
            android:id="@+id/etHostGuests"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="Huéspedes"
            android:inputType="number"
            android:minHeight="48dp"
            android:padding="12dp" />

        <EditText
            android:id="@+id/etHostBedrooms"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="Recámaras"
            android:inputType="number"
            android:minHeight="48dp"
            android:padding="12dp" />

        <EditText
            android:id="@+id/etHostBathrooms"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="Baños"
            android:inputType="numberDecimal"
            android:minHeight="48dp"
            android:padding="12dp" />

        <EditText
            android:id="@+id/etHostImageUrl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="URL de imagen principal (opcional)"
            android:inputType="textUri"
            android:minHeight="48dp"
            android:padding="12dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSubmitProperty"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="20dp"
            android:backgroundTint="#FF385C"
            android:text="Publicar propiedad"
            android:textAllCaps="false"
            android:textColor="@android:color/white"
            android:textStyle="bold" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>