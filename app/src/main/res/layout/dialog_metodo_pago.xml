<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="@android:color/white">

    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:background="#D8D8D8"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="20dp" />

    <LinearLayout
        android:id="@+id/layoutMenuMetodos"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="visible">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Confirma y paga"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#222222"
            android:layout_marginBottom="24dp"/>

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="1dp"
            app:cardBackgroundColor="#F7F7F7">

            <LinearLayout
                android:id="@+id/btnPagoTarjeta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="?android:attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:padding="16dp"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:src="@android:drawable/ic_menu_agenda"
                    app:tint="#FF5A5F" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tarjeta de Crédito o Débito"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#222222"
                    android:layout_marginStart="16dp"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="1dp"
            app:cardBackgroundColor="#F7F7F7">

            <LinearLayout
                android:id="@+id/btnPagoPaypal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="?android:attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:padding="16dp"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:src="@android:drawable/ic_menu_share"
                    app:tint="#003087" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="PayPal"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#222222"
                    android:layout_marginStart="16dp"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="12dp"
            app:cardElevation="1dp"
            app:cardBackgroundColor="#F7F7F7">

            <LinearLayout
                android:id="@+id/btnPagoOxxo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="?android:attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:padding="16dp"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:src="@android:drawable/ic_menu_report_image"
                    app:tint="#E27F00" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="OXXO Pay (Efectivo)"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#222222"
                    android:layout_marginStart="16dp"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/layoutFormularioTarjeta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Detalles de la tarjeta"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#222222"
            android:layout_marginBottom="16dp"/>

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="140dp"
            android:layout_marginBottom="20dp"
            app:cardCornerRadius="14dp"
            app:cardElevation="3dp"
            app:cardBackgroundColor="#2C3E50">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="18dp">

                <View
                    android:id="@+id/viewChip"
                    android:layout_width="32dp"
                    android:layout_height="24dp"
                    android:background="#F1C40F"
                    android:layout_alignParentStart="true"
                    android:layout_alignParentTop="true" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="CARD"
                    android:textColor="#80FFFFFF"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:layout_alignParentEnd="true"
                    android:layout_alignParentTop="true"/>

                <TextView
                    android:id="@+id/tvNumeroSimulado"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="••••  ••••  ••••  ••••"
                    android:textColor="@android:color/white"
                    android:textSize="18sp"
                    android:letterSpacing="0.2"
                    android:layout_centerVertical="true"
                    android:layout_alignParentStart="true" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="VALID THRU"
                    android:textColor="#80FFFFFF"
                    android:textSize="9sp"
                    android:layout_above="@id/tvNombreTitular"
                    android:layout_toStartOf="@id/tvFechaSimulada"
                    android:layout_marginEnd="6dp"
                    android:layout_marginBottom="2dp"/>

                <TextView
                    android:id="@+id/tvFechaSimulada"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="MM/AA"
                    android:textColor="@android:color/white"
                    android:textSize="12sp"
                    android:layout_above="@id/tvNombreTitular"
                    android:layout_alignParentEnd="true"
                    android:layout_marginBottom="2dp"/>

                <TextView
                    android:id="@+id/tvNombreTitular"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Banca Segura"
                    android:textColor="@android:color/white"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:layout_alignParentBottom="true"
                    android:layout_alignParentStart="true"/>

            </RelativeLayout>
        </androidx.cardview.widget.CardView>

        <EditText
            android:id="@+id/etNumeroTarjeta"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:hint="Número de tarjeta (16 dígitos)"
            android:inputType="number"
            android:maxLength="16"
            android:layout_marginBottom="12dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="2"
            android:layout_marginBottom="24dp">

            <EditText
                android:id="@+id/etVencimientoTarjeta"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_weight="1"
                android:hint="MM/AA"
                android:inputType="date"
                android:maxLength="5"
                android:layout_marginEnd="8dp"/>

            <EditText
                android:id="@+id/etCvvTarjeta"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_weight="1"
                android:hint="CVV"
                android:inputType="number"
                android:maxLength="3"
                android:layout_marginStart="8dp"/>
        </LinearLayout>

        <Button
            android:id="@+id/btnFinalizarTarjeta"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="Pagar ahora"
            android:backgroundTint="#FF5A5F"
            android:textColor="@android:color/white"
            android:textStyle="bold"
            app:cornerRadius="10dp"/>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/layoutFormularioPaypal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Iniciar sesión con PayPal"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#003087"
            android:layout_marginBottom="18dp"/>

        <EditText
            android:id="@+id/etCorreoPaypal"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:hint="Correo electrónico"
            android:inputType="textEmailAddress"
            android:layout_marginBottom="16dp"/>

        <EditText
            android:id="@+id/etPasswordPaypal"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:hint="Contraseña"
            android:inputType="textPassword"
            android:layout_marginBottom="24dp"/>

        <Button
            android:id="@+id/btnFinalizarPaypal"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="Autorizar y Pagar"
            android:backgroundTint="#0070ba"
            android:textColor="@android:color/white"
            android:textStyle="bold"
            app:cornerRadius="10dp"/>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/layoutResultadoOxxo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:visibility="gone">

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            app:cardCornerRadius="14dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="#FFFDF2">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp"
                android:gravity="center">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="FICHA DE PAGO DIGITAL"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="#E27F00"
                    android:layout_marginBottom="8dp"/>

                <TextView
                    android:id="@+id/tvMontoOxxo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Total a pagar: $0.00 MXN"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="#222222"
                    android:layout_marginBottom="16dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="|||| | ||||| || |||| ||| ||||"
                    android:letterSpacing="0.6"
                    android:textSize="28sp"
                    android:textColor="#111111"
                    android:layout_marginBottom="8dp"/>

                <TextView
                    android:id="@+id/tvReferenciaOxxo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Referencia: 9876-5432-1012-3456"
                    android:textSize="14sp"
                    android:fontFamily="monospace"
                    android:textColor="#444444"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Dispones de 24 horas para realizar tu pago en cualquier sucursal OXXO. Tu reservación quedará retenida en estado pendiente hasta que se valide el ingreso."
            android:textAlignment="center"
            android:textSize="12sp"
            android:textColor="#D35400"
            android:layout_marginBottom="24dp"
            android:paddingHorizontal="10dp"/>

        <Button
            android:id="@+id/btnEntendidoOxxo"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="Entendido, volver"
            android:backgroundTint="#222222"
            android:textColor="@android:color/white"
            android:textStyle="bold"
            app:cornerRadius="10dp"/>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/layoutCargandoPago"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:visibility="gone"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="16dp">

        <ProgressBar
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:indeterminateTint="#FF5A5F"/>

        <TextView
            android:id="@+id/tvProgresoPago"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Procesando pago seguro..."
            android:textColor="#777777"
            android:layout_marginTop="12dp"
            android:textSize="14sp"/>
    </LinearLayout>
</LinearLayout>